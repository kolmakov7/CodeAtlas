# Embedding model auto-download (profile: embeddings)
MODEL_URL=https://huggingface.co/BAAI/bge-m3/resolve/main/bge-m3-Q8_0.gguf
MODEL_FILE=/models/bge-m3-Q8_0.gguf
LLAMA_ARGS=--embedding --port 8080 --threads 4

# CodeRAG embedding endpoint (inside compose network)
CODERAG__Embedding__Endpoint=http://llama-embeddings:8080/v1/embeddings
CODERAG__Embedding__Model=bge-m3

# Alternative models (examples):
# MODEL_URL=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q8_0.gguf
# MODEL_FILE=/models/nomic-embed-text-v1.5.Q8_0.gguf
