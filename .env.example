# ---------------------------------------------------------------------------
# Dual embedding endpoints (code + text) — two independent OpenAI-compatible
# services. Each domain has its own endpoint, model, and vector space.
# Point them at any external OpenAI-compatible server, or keep the bundled
# llama.cpp containers (started via `docker compose --profile embeddings up`).
# ---------------------------------------------------------------------------

# Code vector space (source code; comments stay code)
CODE_EMBEDDINGS_ENDPOINT=http://code-embeddings:8080/v1/embeddings
CODE_EMBEDDINGS_MODEL=bge-m3
CODE_EMBEDDINGS_DIMENSIONS=0   # 0 = auto-detect from the first response

# Text vector space (Markdown, README, docs, prose)
TEXT_EMBEDDINGS_ENDPOINT=http://text-embeddings:8080/v1/embeddings
TEXT_EMBEDDINGS_MODEL=all-MiniLM-L6-v2
TEXT_EMBEDDINGS_DIMENSIONS=0   # 0 = auto-detect from the first response

# Example: use fully external OpenAI-compatible endpoints instead of the bundled
# llama.cpp containers (leave the `embeddings` profile off):
# CODE_EMBEDDINGS_ENDPOINT=https://api.external-host.com/v1/embeddings
# CODE_EMBEDDINGS_MODEL=code-embed-v1
# TEXT_EMBEDDINGS_ENDPOINT=https://api.external-host.com/v1/embeddings
# TEXT_EMBEDDINGS_MODEL=text-embed-v1

# ---------------------------------------------------------------------------
# Bundled llama.cpp model auto-download (only used by the `embeddings` profile)
# ---------------------------------------------------------------------------
CODE_EMBEDDINGS_MODEL_URL=https://huggingface.co/BAAI/bge-m3/resolve/main/bge-m3-Q8_0.gguf
CODE_EMBEDDINGS_MODEL_FILE=/models/bge-m3-Q8_0.gguf
TEXT_EMBEDDINGS_MODEL_URL=https://huggingface.co/QuantFactory/all-MiniLM-L6-v2-gguf/resolve/main/all-MiniLM-L6-v2-Q8_0.gguf
TEXT_EMBEDDINGS_MODEL_FILE=/models/all-MiniLM-L6-v2-Q8_0.gguf

# Alternative text model (example):
# TEXT_EMBEDDINGS_MODEL_URL=https://huggingface.co/intfloat/e5-mistral-7b-instruct-GGUF/resolve/main/e5-mistral-7b-instruct-Q4_K_M.gguf
# TEXT_EMBEDDINGS_MODEL_FILE=/models/e5-mistral-7b-instruct-Q4_K_M.gguf

# ---------------------------------------------------------------------------
# ASP.NET environment
# ---------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# CODERAG__DataDir=/data
