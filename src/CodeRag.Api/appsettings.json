{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Indexer": {
    "MaxConcurrentIndexers": 2,
    "ParallelFileIndexers": 8
  },
  "Embeddings": {
    "Code": {
      "Endpoint": "http://code-embeddings:8080/v1/embeddings",
      "Model": "bge-m3",
      "Dimensions": 1024,
      "BatchSize": 32
    },
    "Text": {
      "Endpoint": "http://text-embeddings:8080/v1/embeddings",
      "Model": "jina-embeddings-v5-text-small",
      "Dimensions": 1024,
      "BatchSize": 32
    }
  }
}
